# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

/dist-selfhost/
/.nexus-data/
*.tsbuildinfo

# claves y certificados
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.asc
*.gpg

# bases de datos
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# backups y exports
*.bak
*.backup
*.old
*.orig
*.tmp
backup*.json
*-backup.json
*-respaldo.json
dump*.json

# archivos y logs
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.log

# secretos locales / overrides
secrets/
credentials/
*.local.jsonc
!.env.example
